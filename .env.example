# Django Settings
SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL with pgvector required)
DATABASE_URL=postgresql://skillmap_user:skillmap_pass@localhost:5432/skillmap_db

# Redis
REDIS_URL=redis://localhost:6379/0

# Cloudinary (https://cloudinary.com)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Groq API — FREE tier (https://console.groq.com)
# Get your free key at console.groq.com — no credit card needed
GROQ_API_KEY=gsk_your-groq-api-key-here

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
# Set to True for local development without Redis
CELERY_TASK_ALWAYS_EAGER=True

# Email (Gmail SMTP)
# Set up app password at: https://myaccount.google.com/apppasswords
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-gmail@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-app-password
DEFAULT_FROM_EMAIL=SkillMap Nepal <your-gmail@gmail.com>
